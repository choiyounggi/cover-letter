# Local: docker compose up -d   (matches docker-compose.yml; host port 5433, container port 5432 — 5432 avoided to not collide with other local Postgres containers)
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5433/portfolio?schema=public"
# Neon (production): pooled URL for the app, direct URL for migrations
# DATABASE_URL="postgresql://<user>:<pass>@<host>-pooler.neon.tech/<db>?sslmode=require"
# DIRECT_URL="postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require"

# Auth.js — `npx auth secret` generates AUTH_SECRET
AUTH_SECRET="replace-me"
AUTH_GITHUB_ID="replace-me"
AUTH_GITHUB_SECRET="replace-me"
# Only this GitHub login may enter /admin
ADMIN_GITHUB_LOGIN="choiyounggi"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
